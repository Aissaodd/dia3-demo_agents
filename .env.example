# Copie ce fichier en .env et remplis-le.

# Clé DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_KEY=

# Modèle utilisé par Jarvis : deepseek (défaut), claude (CLI Claude Code, abonnement) ou echo (hors ligne, pour tester)
JARVIS_LLM=deepseek
# deepseek-chat (rapide) ou deepseek-reasoner (raisonnement)
JARVIS_MODEL=deepseek-chat

# Limites (facultatif)
# JARVIS_MAX_STEPS=8
# JARVIS_MAX_ATTEMPTS=3
# JARVIS_MAX_TOOL_CALLS=6
# JARVIS_RETRY_DELAY=2

# Outils à couper, séparés par des virgules (ex. lire_page_web,ecrire_fichier)
# JARVIS_DISABLED_TOOLS=
