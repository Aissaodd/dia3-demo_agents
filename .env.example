# Copie ce fichier en .env et remplis-le. Ne le partage jamais (il est dans .gitignore).

# --- Fournisseur de modèles (un seul par défaut, aucun basculement automatique) ---
# deepseek | groq | anthropic | claude (CLI Claude Code, abonnement) | echo (hors ligne, gratuit)
JARVIS_LLM=deepseek
# Vide = modèle par défaut du fournisseur :
#   deepseek  → deepseek-flash   (ou deepseek-v4-pro ; deepseek-chat/reasoner ont été RETIRÉS le 2026-07-24)
#   groq      → openai/gpt-oss-120b
#   anthropic → claude-sonnet-5-5
JARVIS_MODEL=

# Clés (une seule suffit : celle du fournisseur choisi)
DEEPSEEK_KEY=
# GROQ_KEY=
# ANTHROPIC_API_KEY=

# --- Modèle par rôle (facultatif, explicite) : fournisseur:modele ---
# JARVIS_MODEL_PLANNER=deepseek:deepseek-v4-pro
# JARVIS_MODEL_VERIFIER=groq:openai/gpt-oss-120b
# JARVIS_MODEL_SYNTHESIZER=
# JARVIS_MODEL_CHAT=
# JARVIS_MODEL_AGENT=            (tous les agents)
# JARVIS_MODEL_AGENT_CODEUR=     (un seul agent)

# --- Budget par mission (cumulé sur les reprises) ---
# JARVIS_MAX_LLM_CALLS=80
# JARVIS_MAX_TOKENS=500000
# JARVIS_MAX_COST_USD=0.50
# JARVIS_MAX_WEB_CALLS=15
# Prix en $ par million de jetons si un modèle n'est pas connu : {"modele": [entree, sortie]}
# JARVIS_PRICES=

# --- Exécution ---
# JARVIS_MAX_STEPS=8
# JARVIS_MAX_ATTEMPTS=3
# JARVIS_MAX_TOOL_CALLS=6
# JARVIS_MAX_PARALLEL=3
# JARVIS_RETRY_DELAY=2
# JARVIS_LLM_TIMEOUT=120
# JARVIS_STEP_TIMEOUT=600
# JARVIS_MISSION_TIMEOUT=3600

# --- Sécurité ---
# Approbation humaine : sensible (défaut : écraser un fichier) | ecriture (toute écriture ou accès web) | jamais
# JARVIS_APPROVAL=sensible
# Outils à couper, séparés par des virgules (ex. lire_page_web,ecrire_fichier)
# JARVIS_DISABLED_TOOLS=
